{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitexsoftware.github.io/ishtaria-protocol/datadisk.schema.json",
  "title": "Ishtaria datadisk",
  "description": "Definitions for the files of a story datadisk. A datadisk directory holds datadisk.yaml (manifest), places/*.yaml, npcs/*.yaml, dialogues/*.yaml, quests/*.yaml, lore/*.yaml and i18n/<language>.yaml. Each file is validated against the definition named by its directory; $defs/manifest validates datadisk.yaml.",
  "$defs": {
    "local_id": {
      "description": "Identifier unique inside one datadisk; the loader qualifies it as <disk>:<id>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "ref": {
      "description": "Reference to a local id, or to <disk>:<id> of a declared dependency.",
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]{1,31}:)?[a-z][a-z0-9_]{0,47}$"
    },
    "text_key": {
      "description": "Translation key; the text lives in i18n/<language>.yaml.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,95}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "status": {
      "description": "draft = generated and not yet reviewed; release builds reject drafts.",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "requires_ruleset",
        "license",
        "attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "requires_ruleset": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "format": {
          "description": "Datadisk format version this disk follows (DATADISK-SPEC.md); 1 when absent.",
          "const": 1
        },
        "rating": {
          "enum": [
            "general",
            "teen",
            "mature"
          ]
        },
        "cover": {
          "description": "Cover image (png or jpg, at most 1 MiB) that clients show when they connect to a server using the disk.",
          "$ref": "#/$defs/media_path"
        },
        "player_character": {
          "description": "The character every new player of a world using this disk plays, as <pack>/<skin> of the character creator (for example protagonists/criminalMaleA). Players then choose only their nickname; the first disk in the order of application that sets it wins. Existing players keep their character. Without it players choose a look.",
          "type": "string",
          "pattern": "^[a-z]+/[A-Za-z0-9_]{1,48}$"
        },
        "player_model": {
          "description": "A glTF binary below media/models/ (<= 4 MiB, in metres, +Y up, a skeleton with clips named Idle and Walk) that clients draw for the player_character instead of its pack look, which stays the fallback while the model loads. Requires player_character.",
          "type": "string",
          "pattern": "^media/models/[a-z0-9_]+\\.glb$"
        },
        "player_body": {
          "description": "The body of the player_character: how tall it stands and how much more than a man it endures. Clients draw the character that tall (the creator's people are 1.8 m) and the server hurts it less when it falls: the drop counts against the body's size and the damage is divided by toughness. Requires player_character.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height_m"
          ],
          "properties": {
            "height_m": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 8
            },
            "toughness": {
              "type": "number",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disk",
              "version"
            ],
            "properties": {
              "disk": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "Minimum version, same major."
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          }
        }
      }
    },
    "condition": {
      "description": "Structured condition. No scripting: exactly one key.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "flag": {
          "$ref": "#/$defs/ref"
        },
        "quest_stage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quest",
            "stage"
          ],
          "properties": {
            "quest": {
              "$ref": "#/$defs/ref"
            },
            "stage": {
              "$ref": "#/$defs/local_id"
            }
          }
        },
        "has_item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "$ref": "#/$defs/item_id"
            },
            "qty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "gold_at_least": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "description": "Structured effect applied by the server in one transaction.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "give_item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "$ref": "#/$defs/item_id"
            },
            "qty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "take_item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "$ref": "#/$defs/item_id"
            },
            "qty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "gold": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000,
          "not": {
            "const": 0
          }
        },
        "set_flag": {
          "$ref": "#/$defs/ref"
        },
        "set_stage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quest",
            "stage"
          ],
          "properties": {
            "quest": {
              "$ref": "#/$defs/ref"
            },
            "stage": {
              "$ref": "#/$defs/local_id"
            }
          }
        },
        "once": {
          "description": "Apply the nested effects only the first time this key is used by a player.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "effects"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/local_id"
            },
            "effects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/effect"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "places": {
      "description": "places/*.yaml: a list of anchors the world generator must find a spot for.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name_key"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "kind": {
            "enum": [
              "city",
              "building",
              "graveyard",
              "landmark",
              "camp"
            ]
          },
          "name_key": {
            "$ref": "#/$defs/text_key"
          },
          "parent": {
            "$ref": "#/$defs/ref",
            "description": "The place this one stands inside or beside; placed after it, within radius_m."
          },
          "radius_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2000
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "biome": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "height_m": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              "max_slope_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              },
              "near": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "place",
                    "min_m",
                    "max_m"
                  ],
                  "properties": {
                    "place": {
                      "$ref": "#/$defs/ref"
                    },
                    "min_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "max_m": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              "coast": {
                "type": "boolean"
              }
            }
          },
          "spacing_m": {
            "type": "number",
            "minimum": 10,
            "maximum": 1000000
          },
          "scenery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preset"
            ],
            "properties": {
              "preset": {
                "enum": [
                  "town",
                  "graveyard",
                  "fortress"
                ]
              },
              "size": {
                "enum": [
                  "hamlet",
                  "village",
                  "town"
                ]
              }
            }
          },
          "structure": {
            "type": "object",
            "description": "A building of the datadisk itself, drawn at the place and walkable by its mesh (stairs up to 0.45 m per step, arches, platforms). Excludes scenery.",
            "additionalProperties": false,
            "required": [
              "model"
            ],
            "properties": {
              "model": {
                "type": "string",
                "pattern": "^media/models/([a-z0-9_]+/)*[a-z0-9_]+\\.glb$",
                "description": "A self-contained glTF binary (<= 4 MiB, metres, +Y up) whose origin stands on the ground."
              },
              "collision": {
                "type": "string",
                "pattern": "^media/models/([a-z0-9_]+/)*[a-z0-9_]+\\.glb$",
                "description": "A simpler glTF binary used for collision and walking instead of model."
              },
              "scale_m": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 20,
                "description": "Metres per model unit; default 1."
              },
              "yaw_deg": {
                "type": "number",
                "minimum": -360,
                "maximum": 360,
                "description": "Turn about the vertical axis; default 0."
              },
              "offset_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -2000,
                  "maximum": 2000
                },
                "description": "Shift from the anchor of the place in metres along the client's local x and z axes."
              },
              "ground_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "description": "The point of the model (x and z in model units, before the turn) that stands on the ground, such as the foot of its stairs; the model's height follows the terrain there. Defaults to the origin."
              },
              "visible_m": {
                "type": "number",
                "minimum": 50,
                "maximum": 5000,
                "description": "Distance up to which the server announces the building; default 600."
              }
            }
          },
          "terrain": {
            "type": "object",
            "description": "A landscape patch anchored at the place: real-world relief around the site (river banks, tells), replacing the base terrain and procedural relief inside its rectangle. Heights are decimetres above the anchor's placed height, so the patch is portable between worlds.",
            "additionalProperties": false,
            "required": [
              "heightmap",
              "extent_m"
            ],
            "properties": {
              "heightmap": {
                "type": "string",
                "pattern": "^media/terrain/[a-z0-9_]+\\.png$",
                "description": "A 16-bit greyscale PNG (at most 4 MiB) whose value 0x8000 is the anchor's placed height; other pixels are decimetres above it."
              },              "water": {
                "type": "string",
                "pattern": "^media/terrain/[a-z0-9_]+\\.png$",
                "description": "An equally sized 16-bit greyscale PNG: 0 is dry land, other pixels the water surface in decimetres above the anchor (0x8000), a river at its historical course."
              },
              "extent_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 100,
                  "maximum": 10000
                },
                "description": "The size of the rectangle in the client's local x and z frame, centred on offset_m."
              },
              "offset_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -5000,
                  "maximum": 5000
                },
                "description": "The centre of the rectangle from the place anchor in metres along the local x and z axes; the anchor must stay inside the feathered core."
              },
              "feather_m": {
                "type": "number",
                "minimum": 10,
                "maximum": 500,
                "description": "Width of the margin across which the patch blends into the base terrain; default 100."
              },
              "visible_m": {
                "type": "number",
                "minimum": 100,
                "maximum": 5000,
                "description": "Distance from the patch edge up to which the server announces it; default 1200."
              }
            }
          },
          "music": {
            "$ref": "#/$defs/local_id",
            "description": "Track (id from music/*.yaml) that plays in the background while the player is within music_radius_m of the place."
          },
          "music_radius_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5000,
            "description": "Distance from the place within which its music is heard (fades towards the edge); defaults to radius_m."
          },
          "spawn": {
            "type": "boolean",
            "description": "New characters of the world appear here. At most one place of a disk; with several disks the first one in the order of application wins."
          },
          "locate": {
            "description": "Where on the planet the place lies, measured from another place (the real geography of a story): distance_m from `from` in the direction bearing_deg of the map of `from`, that is the frame of its landscape patch and buildings (0 is up the map, north; 90 is east), along a great circle. The planet is not the Earth, so the site is the nearest one within tolerance_m of that point that satisfies the place's `requires`; placement fails when there is none. Not with `at`.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "bearing_deg",
              "distance_m"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/ref"
              },
              "bearing_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "distance_m": {
                "type": "number",
                "minimum": 1,
                "maximum": 20000000
              },
              "tolerance_m": {
                "type": "number",
                "minimum": 1,
                "maximum": 5000000,
                "description": "How far from the exact point a site may lie; default a twentieth of the distance, at least 30 m."
              }
            }
          },
          "at": {
            "enum": [
              "gate",
              "alley"
            ],
            "description": "Fixes the place to a spot of its parent's walled town: the main gate (just inside the wall) or a back alley far from it, out of the gate guard's sight and hearing. Requires a parent with the town preset and size town."
          }
        }
      }
    },
    "npcs": {
      "description": "npcs/*.yaml: characters standing at a place.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "place",
          "character",
          "dialogue"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "name_key": {
            "$ref": "#/$defs/text_key"
          },
          "place": {
            "$ref": "#/$defs/ref"
          },
          "character": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pack",
              "skin"
            ],
            "properties": {
              "pack": {
                "enum": [
                  "protagonists",
                  "retro",
                  "survivors"
                ]
              },
              "skin": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,48}$"
              },
              "model": {
                "description": "A glTF binary below media/models/ (<= 4 MiB) drawn instead of the pack character; pack and skin stay the fallback.",
                "type": "string",
                "pattern": "^media/models/[a-z0-9_]+\\.glb$"
              }
            }
          },
          "dialogue": {
            "$ref": "#/$defs/ref"
          },
          "bio_key": {
            "$ref": "#/$defs/text_key"
          },
          "movement": {
            "description": "The character walks instead of standing at its place. Where it is depends only on its id, its place and the time (nothing is stored); servers send a route of waypoints and clients walk the character along it, with the Walk clip of its model while it moves and Idle while it stands. A character that keeps a shop (tag shop:<id>) cannot walk.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "wander",
                  "patrol"
                ],
                "description": "wander: walks to spots near its place, standing between walks; patrol: walks the loop of waypoints."
              },
              "radius_m": {
                "type": "number",
                "minimum": 1,
                "maximum": 200,
                "default": 25,
                "description": "How far from its place a wanderer goes."
              },
              "speed_m_s": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 8,
                "default": 1,
                "description": "Walking speed."
              },
              "pause_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 120,
                "default": 6,
                "description": "How long it stands between walks (at each waypoint of a patrol)."
              },
              "waypoints": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "description": "The loop of a patrol: metres east and south of the place, as offset_m of a building. Not for wanderers.",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                }
              }
            }
          },
          "size": {
            "description": "How many times taller than the model as authored the character stands (a god towers over men); default 1.",
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/local_id"
            }
          },
          "portrait": {
            "$ref": "#/$defs/media_path"
          }
        }
      }
    },
    "dialogue": {
      "description": "dialogues/<name>.yaml: one decision tree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "generated_by": {
          "type": "string",
          "maxLength": 120
        },
        "start": {
          "$ref": "#/$defs/local_id"
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 200,
          "propertyNames": {
            "$ref": "#/$defs/local_id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text_key": {
                "$ref": "#/$defs/text_key"
              },
              "branch": {
                "description": "Automatic routing: the first entry whose condition holds (or has none) is taken; the node shows no text.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "goto"
                  ],
                  "properties": {
                    "if": {
                      "$ref": "#/$defs/condition"
                    },
                    "goto": {
                      "$ref": "#/$defs/local_id"
                    }
                  }
                }
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text_key"
                  ],
                  "properties": {
                    "text_key": {
                      "$ref": "#/$defs/text_key"
                    },
                    "if": {
                      "$ref": "#/$defs/condition"
                    },
                    "effects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/effect"
                      }
                    },
                    "goto": {
                      "$ref": "#/$defs/local_id",
                      "description": "Next node; omitted ends the conversation."
                    }
                  }
                }
              },
              "effects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/effect"
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "branch"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "text_key"
                      ]
                    },
                    {
                      "required": [
                        "choices"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "text_key"
                ],
                "not": {
                  "required": [
                    "branch"
                  ]
                }
              }
            ]
          }
        },
        "music": {
          "$ref": "#/$defs/local_id",
          "description": "Track from music/*.yaml played during the conversation."
        }
      }
    },
    "quest": {
      "description": "quests/<name>.yaml: a scenario as a state machine; stages are advanced by dialogue effects.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_key",
        "start_stage",
        "stages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "title_key": {
          "$ref": "#/$defs/text_key"
        },
        "start_stage": {
          "$ref": "#/$defs/local_id"
        },
        "start_place": {
          "description": "Place where the quest begins; the aetherglass compass shows it as the next story point until the quest is started.",
          "$ref": "#/$defs/ref"
        },
        "stages": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/local_id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text_key"
            ],
            "properties": {
              "text_key": {
                "$ref": "#/$defs/text_key"
              },
              "final": {
                "type": "boolean"
              },
              "guide": {
                "description": "Place the aetherglass compass points to during this stage (defaults to the reach place).",
                "$ref": "#/$defs/ref"
              },
              "reach": {
                "description": "Moves the quest to stage `goto` when the player comes within radius_m of the place.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "place",
                  "radius_m",
                  "goto"
                ],
                "properties": {
                  "place": {
                    "$ref": "#/$defs/ref"
                  },
                  "radius_m": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 2000
                  },
                  "goto": {
                    "$ref": "#/$defs/local_id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "lore": {
      "description": "lore/*.yaml: codex entries (gods, traditions); never spawned.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_key",
          "text_key"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "category": {
            "enum": [
              "god",
              "primordial",
              "tradition",
              "place",
              "history",
              "artifact",
              "concept"
            ]
          },
          "title_key": {
            "$ref": "#/$defs/text_key"
          },
          "text_key": {
            "$ref": "#/$defs/text_key"
          }
        }
      }
    },
    "strings": {
      "description": "i18n/<language>.yaml: flat map of text keys to text (at most 2000 characters each).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/text_key"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "media_path": {
      "description": "Path of a file inside the datadisk, below media/ (png, jpg or ogg).",
      "type": "string",
      "pattern": "^media/[a-z0-9_]+(/[a-z0-9_]+)*/[a-z0-9_.-]+\\.(png|jpg|ogg|glb)$"
    },
    "music": {
      "description": "music/*.yaml: tracks (OGG Vorbis) a dialogue can play.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "title_key"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/local_id"
          },
          "file": {
            "$ref": "#/$defs/media_path"
          },
          "title_key": {
            "$ref": "#/$defs/text_key"
          },
          "loop": {
            "type": "boolean"
          }
        }
      }
    },
    "voices": {
      "description": "voice/voices.yaml: how the build tool (render_voices.py) synthesizes the spoken lines. Not read by the server: the server only serves media/voice/<language>/<text_key>.ogg. A recording at that path always replaces a synthetic line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "description": "Piper model per language (two lowercase letters).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "placeholders": {
          "description": "What a recording says for a placeholder of the texts, per language: {player} (the name the player chose) is replaced by this form of address. A text key `<key>.say` in i18n replaces the whole text for the voice.",
          "type": "object",
          "properties": {
            "player": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2}$"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "loudness": {
          "description": "Integrated loudness of the spoken lines in LUFS per language (two lowercase letters); `default` applies to the other languages. The lines of a language are normalised to it; human recordings are not touched.",
          "type": "object",
          "propertyNames": {
            "pattern": "^([a-z]{2}|default)$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -70,
            "maximum": 0
          }
        },
        "default": {
          "$ref": "#/$defs/voice_profile"
        },
        "npcs": {
          "description": "Per NPC id: a voice profile, plus optional per-language overrides keyed by language.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/voice_profile"
          }
        }
      }
    },
    "voice_profile": {
      "type": "object",
      "properties": {
        "length_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
        "noise_scale": {"type": "number", "minimum": 0, "maximum": 2},
        "noise_w": {"type": "number", "minimum": 0, "maximum": 2},
        "pitch": {"description": "Semitones.", "type": "number", "minimum": -12, "maximum": 12},
        "tempo": {"type": "number", "minimum": 0.5, "maximum": 2},
        "speaker": {"description": "Speaker id of a multi-speaker model.", "type": "integer", "minimum": 0},
        "eq": {"enum": ["bass", "bright", "muffled"]},
        "echo": {"enum": ["crypt", "hall"]}
      },
      "additionalProperties": {
        "$ref": "#/$defs/voice_profile"
      }
    }
  }
}
